# .env.prod
# Copy this file to .env.prod and fill in your production values.
# Do NOT commit your actual .env.prod file to version control.
#
# IMPORTANT - FAIL-FAST STARTUP VALIDATION:
# In production (SPRING_PROFILES_ACTIVE=prod), the backend validates all security settings at startup.
# The application will TERMINATE IMMEDIATELY if:
#   - Any placeholder values (CHANGE_ME, YOUR_STRONG_, SECRET_HERE, Password@123, etc.) are detected.
#   - Passwords are weak (DB/Redis < 8 chars, Admin < 12 chars).
#   - JWT secrets are invalid, shorter than 256 bits (32 bytes decoded), or identical.
#   - CORS origins contain localhost, 127.0.0.1, wildcard '*', or missing HTTPS scheme.
#   - Redis host points to localhost or Redis password is empty/unconfigured.
#   - Cookie secure flag is false.

# Database Configuration (MariaDB)
# Dedicated least-privilege application database user (cannot be 'root' in production)
DB_USER=japanese_learning_user
# Strong, random password for application user (minimum 12 characters, no placeholders)
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
# Dedicated administrator (root) password for maintenance, migrations, and automated backups
DB_ROOT_PASSWORD=YOUR_STRONG_ROOT_PASSWORD_HERE

# Network Exposure Configuration
# Bind address for backend API port (defaults to 127.0.0.1 so traffic must pass through reverse proxy/HTTPS)
BACKEND_BIND_IP=127.0.0.1

# Database URL and Username (optional if using docker-compose.prod.yml which sets defaults for the 'db' container)
# Uncomment and configure if running the backend standalone outside Docker Compose:
# DB_URL=jdbc:mariadb://db.yourdomain.com:3306/japanese_learning_db?useSSL=true&serverTimezone=Asia/Ho_Chi_Minh
# DB_USERNAME=japanese_learning_user

# Redis Configuration
# Required for distributed rate limiting in production (profile=prod)
# Use a strong, random password for Redis in production (minimum 12 characters)
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE
# Redis Host and Port (optional if using docker-compose.prod.yml which sets host='redis', port=6379)
# Uncomment if running the backend standalone outside Docker Compose:
# REDIS_HOST=redis.yourdomain.com
# REDIS_PORT=6379

# Admin Setup Configuration
# Initial admin password when the system seeds the admin user (minimum 12 characters)
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# JWT Secrets (Must be Base64-encoded, at least 256 bits / 32 bytes decoded, and distinct from each other)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# CORS Configuration
# Comma-separated list of allowed frontend origins (MUST use HTTPS, NO localhost, NO trailing slash, NEVER wildcard '*')
# Example: https://yourdomain.com,https://admin.yourdomain.com
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Cookie Configuration (for Refresh Token)
# secure: true (MUST be true in production HTTPS)
# same-site: Strict (recommended for same-origin reverse-proxy), Lax (subdomains), or None (cross-site).
# NOTE: If same-site=None, secure MUST be true!
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Strict

# Rate Limiter Failure Policy (FAIL_CLOSED | FAIL_OPEN)
# FAIL_CLOSED: blocks auth requests if Redis is unreachable (maximum security, default in prod)
# FAIL_OPEN: allows requests if Redis is unreachable (used for emergency recovery)
APP_RATE_LIMIT_REDIS_FAILURE_POLICY=FAIL_CLOSED

# Media URL Security (Optional allowlist for avatar/thumbnail URLs)
# Comma-separated domains allowed for media URLs. If blank, any HTTPS URL is allowed in prod.
# Example: s3.amazonaws.com,res.cloudinary.com,storage.googleapis.com
APP_MEDIA_TRUSTED_DOMAINS=

# Payment Simulation (MUST be false in production)
APP_PAYMENT_SIMULATION_ENABLED=false

# Backup & Disaster Recovery Configuration
# Passphrase for AES-256-CBC PBKDF2 encryption (minimum 32 characters, no placeholders)
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
# Base directory for backups on host/volume
BACKUP_DIR=/var/backups/japanese-learning-db
# Retention: Daily (7 days), Weekly (4 weeks), Monthly (12 months)
RETENTION_DAYS_DAILY=7
RETENTION_WEEKS=4
RETENTION_MONTHS=12
# External storage sync: none | s3 | rclone | rsync
EXTERNAL_STORAGE_TYPE=none
EXTERNAL_STORAGE_DEST=
# Failure alert webhook (optional Slack/Discord/Alertmanager URL)
BACKUP_NOTIFICATION_WEBHOOK=


