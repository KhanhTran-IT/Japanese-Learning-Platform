# ==============================================================================
# Database Backup & Recovery Environment Configuration
# Copy this file to backup.env or export these variables in your backup runner
# DO NOT COMMIT REAL PRODUCTION PASSWORDS OR ENCRYPTION KEYS TO VERSION CONTROL
# ==============================================================================

# ---- Database Connection ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=japanese_learning_db
DB_USER=root
# DB_PASSWORD should match DB_PASSWORD in .env.prod
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

# ---- Execution Mode ----
# If USE_DOCKER_EXEC=true, dump is run via 'docker exec $DOCKER_CONTAINER'
# If false, dump uses local mariadb-dump / mysqldump connecting to DB_HOST:DB_PORT
USE_DOCKER_EXEC=false
DOCKER_CONTAINER=japanese_learning_db_prod

# ---- Storage & Directories ----
# Base directory for backup files (daily, weekly, monthly subdirectories)
BACKUP_DIR=/var/backups/japanese-learning-db
# Minimum size in bytes for a dump to be considered valid (failsafe against empty dumps)
MIN_BACKUP_SIZE_BYTES=10240

# ---- Security & Encryption ----
# Passphrase for AES-256-CBC PBKDF2 encryption (must be strong, >= 32 characters)
# Alternatively, store in a protected file: BACKUP_ENCRYPTION_KEY_FILE=/etc/backup.key
BACKUP_ENCRYPTION_KEY=YOUR_SECURE_ENCRYPTION_PASSPHRASE_HERE
# BACKUP_ENCRYPTION_KEY_FILE=/path/to/encryption.key

# ---- Retention Policy ----
# Number of daily backups to keep (e.g., 7 days)
RETENTION_DAYS_DAILY=7
# Number of weekly backups to keep (e.g., 4 weeks)
RETENTION_WEEKS=4
# Number of monthly backups to keep (e.g., 12 months)
RETENTION_MONTHS=12

# ---- External Storage Synchronization ----
# Options: none | s3 | rclone | rsync
EXTERNAL_STORAGE_TYPE=none
# Examples:
# For s3: s3://my-organization-backups/japanese-learning-db/
# For rclone: remote_name:bucket_name/backups/
# For rsync: backupuser@backup.internal:/var/remote-backups/japanese-learning-db/
EXTERNAL_STORAGE_DEST=

# ---- Failure Alerting ----
# Optional Webhook URL (Slack, Discord, Alertmanager, or monitoring bridge)
BACKUP_NOTIFICATION_WEBHOOK=
