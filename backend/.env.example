# .env.example
# Copy this file to .env and fill in your own values for local development.
# Do NOT commit your actual .env file to version control.

# Database Configuration (MariaDB)
DB_PASSWORD=CHANGE_ME_db_password

# Admin Setup Configuration
ADMIN_PASSWORD=CHANGE_ME_admin_password

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Redis Configuration (only needed for prod profile or Redis rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional overrides for standalone production run
# DB_URL=jdbc:mariadb://localhost:3306/japanese_learning_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
# DB_USERNAME=root
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# APP_COOKIE_SECURE=false
# APP_COOKIE_SAME_SITE=Lax
# APP_RATE_LIMIT_REDIS_FAILURE_POLICY=fail-open
# APP_MEDIA_TRUSTED_DOMAINS=
